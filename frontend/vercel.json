{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://cliniscan-ai.onrender.com/api/$1" },
    { "source": "/uploads/(.*)", "destination": "https://cliniscan-ai.onrender.com/uploads/$1" },
    { "source": "/results/(.*)", "destination": "https://cliniscan-ai.onrender.com/results/$1" },
    { "source": "/reports/(.*)", "destination": "https://cliniscan-ai.onrender.com/reports/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
